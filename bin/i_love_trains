#! /usr/bin/env ruby

require 'date' # needed to load DateTime so it can be used as an input
require 'json' # this should be loaded by default, but just in case
require 'irb'

# with a project this small it would arguably be better to use require_relative
# I did it this way because I wanted to refresh my memory how this type of autoloading works
# prepend the dir i_love_trains to the load path so we can then require our project files
$LOAD_PATH.unshift(File.expand_path('..', __FILE__))

# iterate through the ruby files in the lib dir and require each of them
Dir.glob(File.join($LOAD_PATH.first, '..', 'lib', '**', '*.rb')).each do |file|
  require file
end

puts <<~STR
Welcome to the trainline bot. You can go anywhere you want, as long as what you want 
is to go from Munich to Berlin on November 14, 2025, at 4:46PM, or from Munich to 
Stockholm on November 12, 2025, at 3:45AM.

To travel to the past and go to Berlin, please enter the following:

Scraper::Thetrainline.find(from: 'Munich Hbf', to: 'Berlin Hbf (tief)', departure_at: DateTime.new(2025, 11, 14, 16, 46, 0, '+01:00'))

To go to Stockholm, please use this instead:

Scraper::Thetrainline.find(from: 'Munich Hbf', to: 'Stockholm Central Bus Station', departure_at: DateTime.new(2025, 11, 12, 03, 45, 0, '+01:00'))

Once you are done, enter `exit` to leave the program.
STR

IRB.start